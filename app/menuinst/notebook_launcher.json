{
  "$schema": "https://schemas.conda.org/menuinst/menuinst-1-1-3.schema.json",
  "menu_name": "StarDist2D",
  "menu_items": [
    {
      "name": "StarDist2D",
      "description": "Launch StarDist2D in its packaged JupyterLab environment.",
      "activate": true,
      "terminal": true,
      "working_dir": "{{ HOME }}",
      "command": [
        "{{ PYTHON }}",
        "{{ PREFIX }}/StarDist2D/launch_jupyter.py",
        "{{ PREFIX }}/StarDist2D/notebooks/Welcome.ipynb"
      ],
      "platforms": {
        "win": {
          "icon": "",
          "command": [
            "{{ PYTHON }}",
            "{{ PREFIX }}/StarDist2D/launch_jupyter.py",
            "{{ PREFIX }}/StarDist2D/notebooks/Welcome.ipynb",
            "&",
            "exit"
          ]
        },
        "linux": {
          "icon": ""
        },
        "osx": {
          "icon": ""
        }
      }
    }
  ]
}
